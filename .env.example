# ── Auth ────────────────────────────────────────────────────────────────────
# The Agent SDK reuses your Claude Code login (~/.claude/.credentials.json) when
# no key is set. Set this only to bill an API key instead of your subscription.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Engine ──────────────────────────────────────────────────────────────────
# Model that authors the compositions.
FILMWRIGHT_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
FILMWRIGHT_EFFORT=high
# Per-frame workers (ADR-0016): the model and effort each frame is authored with,
# how many run at once, and the turn cap for one frame. Sonnet at medium is the
# starting hypothesis; compare against opus on the same briefs before settling.
FILMWRIGHT_WORKER_MODEL=claude-sonnet-5-5
FILMWRIGHT_WORKER_EFFORT=medium
FILMWRIGHT_WORKER_CONCURRENCY=4
FILMWRIGHT_WORKER_MAX_TURNS=40
# Where the HyperFrames skills live (the packet builder and worker contract).
# FILMWRIGHT_SKILLS_DIR=/home/you/.claude/skills
# Fail the check stage on warnings too (ADR-0017). Off: errors only.
FILMWRIGHT_CHECK_STRICT=false
# Hard ceiling per job. The run is abandoned when it is exceeded.
# A 25s narrated promo reached storyboard (no frames yet) at $8.18 / 82 turns,
# so budget generously — an exhausted run is resumable but not free.
FILMWRIGHT_MAX_BUDGET_USD=25
# Wall-clock ceiling per job, in minutes.
FILMWRIGHT_TIMEOUT_MINUTES=90
# How many times the worker may continue a failed run on its own, reusing the
# work on disk. 0 means every retry is a decision someone makes on the job page.
# Never applies to a budget or timeout stop: those hit the same ceiling again.
FILMWRIGHT_AUTO_CONTINUE=0
# hyperframes CLI version pinned into every generated project.
FILMWRIGHT_HYPERFRAMES_VERSION=0.8.153
# Renderer driver: local (only implemented driver today).
FILMWRIGHT_RENDERER=local

# ── Media ───────────────────────────────────────────────────────────────────
# There are no credentials to configure here, and that is the point: every
# media provider the platform can use is free and needs no account, key or
# subscription. Voice, music, imagery and footage are chosen per job on the
# form, from the catalog in packages/engine/src/providers.ts.
#
# The one thing worth declaring is which interpreter the local models run on.
# `npm run setup` builds them under ~/.venvs, and the engine points at those
# automatically when these are unset — set them to pin a different one.
# HYPERFRAMES_PYTHON=/home/you/.venvs/kokoro/bin/python
# FILMWRIGHT_MUSICGEN_PYTHON=/home/you/.venvs/musicgen/bin/python
#
# Preflight them with `npm run doctor`, or on their own:
#   node scripts/free-media.mjs doctor
#
# Adding a provider that needs a credential would break the platform's one
# hard guarantee — see docs/adr/0013-free-only-media-providers.md.

# ── Workflow ────────────────────────────────────────────────────────────────
# How far the finished timeline may sit from the brief's target length, as a
# fraction of it (with a 2s floor). The platform checks this before it renders
# and tells the agent the number up front. Raising it past ~0.25 makes the
# check decorative; dropping it to 0.1 fires on ordinary craft variance.
FILMWRIGHT_DURATION_TOLERANCE=0.2

# ── Interaction ─────────────────────────────────────────────────────────────
# Let runs ask questions and pause for sign-off. Set to false for fully
# unattended generation (the per-job toggle on the form overrides this).
FILMWRIGHT_INTERACTIVE=true
# How long a run waits on an unanswered question before parking itself and
# handing the worker back to the queue, when NOBODY has the job page open.
# Keep this short: a run nobody is watching should hand the worker back in
# seconds, and the question survives on the job either way.
FILMWRIGHT_ANSWER_GRACE_SECONDS=60
# The grace used instead while somebody IS watching. The studio's event stream
# heartbeats while a job page is open, so an attended run gets the long window
# to actually read and answer in, and parking never interrupts a person.
FILMWRIGHT_ANSWER_GRACE_MINUTES=10
# How stale that heartbeat may be and still count as "someone is watching".
FILMWRIGHT_VIEWER_FRESH_SECONDS=20

# ── Web ─────────────────────────────────────────────────────────────────────
PORT=3100
# The studio is unauthenticated by design, so it listens on the loopback
# interface only. Set 0.0.0.0 to reach it from another machine — and read
# docs/operations/security.md first: anyone who can reach it can spend money.
# HOST=127.0.0.1
