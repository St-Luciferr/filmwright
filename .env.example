# ── Auth ────────────────────────────────────────────────────────────────────
# The Agent SDK reuses your Claude Code login (~/.claude/.credentials.json) when
# no key is set. Set this only to bill an API key instead of your subscription.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Engine ──────────────────────────────────────────────────────────────────
# Model that authors the compositions.
FILMWRIGHT_MODEL=claude-opus-5
# Reasoning effort: low | medium | high | xhigh | max
FILMWRIGHT_EFFORT=high
# Hard ceiling per job. The run is abandoned when it is exceeded.
# A 25s narrated promo reached storyboard (no frames yet) at $8.18 / 82 turns,
# so budget generously — an exhausted run is resumable but not free.
FILMWRIGHT_MAX_BUDGET_USD=25
# Wall-clock ceiling per job, in minutes.
FILMWRIGHT_TIMEOUT_MINUTES=90
# hyperframes CLI version pinned into every generated project.
FILMWRIGHT_HYPERFRAMES_VERSION=0.8.12
# Renderer driver: local (only implemented driver today).
FILMWRIGHT_RENDERER=local

# ── Media ───────────────────────────────────────────────────────────────────
# There is nothing to configure here, and that is the point: every media
# provider the platform can use is free and needs no account, key or
# subscription. Voice, music, imagery and footage are chosen per job on the
# form, from the catalog in packages/engine/src/providers.ts.
#
# Preflight them with `npm run doctor`, or on their own:
#   node scripts/free-media.mjs doctor
#
# Adding a provider that needs a credential would break the platform's one
# hard guarantee — see docs/adr/0013-free-only-media-providers.md.

# ── Interaction ─────────────────────────────────────────────────────────────
# Let runs ask questions and pause for sign-off. Set to false for fully
# unattended generation (the per-job toggle on the form overrides this).
FILMWRIGHT_INTERACTIVE=true
# How long a run waits on an unanswered question before parking itself and
# handing the worker back to the queue.
FILMWRIGHT_ANSWER_GRACE_MINUTES=10

# ── Web ─────────────────────────────────────────────────────────────────────
PORT=3100
